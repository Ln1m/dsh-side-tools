{
  "name": "dsh-tools",
  "version": "0.1.0",
  "description": "工具栏：左栏「工具」Tab 的面板，含卡片范式与两张反代卡（自研局域网 / 第三方公网）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Ln1m (https://github.com/Ln1m)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ln1m/dsh-tools.git"
  },
  "homepage": "https://github.com/Ln1m/dsh-tools#readme",
  "bugs": {
    "url": "https://github.com/Ln1m/dsh-tools/issues"
  }
}
